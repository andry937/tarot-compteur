# Config Firebase (Projet > Paramètres du projet > Vos applications > app Web).
# Ces valeurs ne sont pas secrètes (config publique standard d'une app Firebase
# cliente) mais restent en variables d'environnement pour changer de projet
# entre le poste de dev et le déploiement Vercel sans toucher au code.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Compte Firebase Auth partagé par toute la table (voir CLAUDE.md, Persistance/
# Firebase) : l'email est juste un identifiant, pas un secret — le vrai
# passphrase est le mot de passe de ce compte, défini dans la console
# Firebase (Authentication > Users), jamais dans ce dépôt.
VITE_TAROT_AUTH_EMAIL=table@tarot-compteur.local
